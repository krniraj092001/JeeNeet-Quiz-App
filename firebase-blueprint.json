{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "isSubscribed": { "type": "boolean", "description": "Subscription status" },
        "paymentId": { "type": "string", "description": "Razorpay payment ID" },
        "orderId": { "type": "string", "description": "Razorpay order ID" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["uid", "isSubscribed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and subscription data"
    }
  }
}
