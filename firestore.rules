rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (Firebase Auth UID)
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (optional) - User email
    //   - isSubscribed: boolean (required) - Subscription status
    //   - paymentId: string (optional) - Razorpay payment ID
    //   - orderId: string (optional) - Razorpay order ID
    //   - updatedAt: timestamp (optional) - Last update timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "krniraj092001@gmail.com" && request.auth.token.email_verified == true));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'isSubscribed']) &&
             data.uid is string &&
             data.isSubscribed is bool;
    }

    function isValidQuizResult(data) {
      return data.keys().hasAll(['userName', 'userEmail', 'examType', 'subject', 'score', 'totalQuestions', 'correctAnswers', 'wrongAnswers', 'unanswered', 'timeElapsed', 'timestamp', 'questions']) &&
             data.userName is string && data.userName.size() < 100 &&
             data.userEmail is string && data.userEmail.size() < 100 &&
             data.examType is string &&
             data.subject is string &&
             data.score is number &&
             data.totalQuestions is number &&
             data.correctAnswers is number &&
             data.wrongAnswers is number &&
             data.unanswered is number &&
             data.timeElapsed is number &&
             data.timestamp is number &&
             data.questions is list && data.questions.size() <= 100;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own profile, but only with isSubscribed: false initially
      // (Subscription is updated via server-side webhook)
      allow create: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.isSubscribed == false;
      
      // Users cannot update their own subscription status (only server/admin can)
      allow update: if (isOwner(userId) && 
                        isValidUser(request.resource.data) &&
                        request.resource.data.isSubscribed == resource.data.isSubscribed) ||
                      isAdmin();
      
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      // Results are publicly readable via the shareable link
      allow read: if true;
      
      // Allow anyone to create a result (including anonymous)
      // We still validate the data structure strictly
      allow create: if isValidQuizResult(request.resource.data);
      
      // Results are immutable once created
      allow update, delete: if isAdmin();
    }
  }
}
